# ============================================
# SIGA - Arquivo de Configuração de Ambiente
# ============================================
# 
# INSTRUÇÕES:
# 1. Copie este arquivo para .env na mesma pasta
# 2. Preencha todas as variáveis com os valores reais
# 3. NUNCA commite o arquivo .env no Git
# 4. O arquivo .env já está no .gitignore
#
# ============================================

# ============================================
# DJANGO - CONFIGURAÇÕES BÁSICAS
# ============================================

# SECRET_KEY: Chave secreta do Django (OBRIGATÓRIO - NÃO USE O VALOR PADRÃO EM PRODUÇÃO!)
# Gere uma nova chave com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# IMPORTANTE: Substitua este valor por uma chave segura gerada especialmente para seu ambiente!
SECRET_KEY=SUA_SECRET_KEY_AQUI_GERE_UMA_NOVA_CHAVE_SEGURA

# DEBUG: Modo de debug (OBRIGATÓRIO - False em produção!)
# Valores aceitos: 'True' ou 'False' (como string)
# Em produção, SEMPRE use: DEBUG=False
DEBUG=False

# ALLOWED_HOSTS: Hosts permitidos (separados por vírgula)
ALLOWED_HOSTS=gabinete.mogidascruzes.sp.gov.br,192.168.10.50,localhost,127.0.0.1

# SITE_URL: URL base do site
SITE_URL=https://gabinete.mogidascruzes.sp.gov.br

# ============================================
# BANCO DE DADOS - MySQL
# ============================================

DB_ENGINE=django.db.backends.mysql
DB_NAME=gabinete_db
DB_USER=gabinete_user
DB_PASSWORD=qDGP8oBBSMVn6ET
DB_HOST=localhost
DB_PORT=3306

# ============================================
# E-MAIL - SMTP (MailGrid)
# ============================================

EMAIL_HOST=cloud77.mailgrid.net.br
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
SMTP_USER=
SMTP_PASSWORD=
DEFAULT_FROM_EMAIL=comunicacao.gabinete@mogidascruzes.sp.gov.br

# ============================================
# GOOGLE API - OAuth e Calendar
# ============================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================
# GEMINI AI - API Key
# ============================================

GEMINI_API_KEY=AIzaSyA2truqQXMGO-nnLenO7Thtz49e1mTThgo

# ============================================
# CELERY - Redis (Tarefas Assíncronas)
# ============================================

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================
# SEGURANÇA - Configurações Adicionais
# ============================================

# SECURE_SSL_REDIRECT: Redirecionar HTTP para HTTPS (True em produção)
SECURE_SSL_REDIRECT=False

# SECURE_PROXY_SSL_HEADER: Header para detectar HTTPS via proxy
# Já configurado no settings.py como ('HTTP_X_FORWARDED_PROTO', 'https')

# SESSION_COOKIE_SECURE: Cookies de sessão apenas via HTTPS (True em produção)
SESSION_COOKIE_SECURE=False

# CSRF_COOKIE_SECURE: Cookies CSRF apenas via HTTPS (True em produção)
CSRF_COOKIE_SECURE=False
